# OpenRouter — https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Gmail OAuth (recommended). Download Desktop-app credentials from Google Cloud
# and save as credentials.json in this folder. Then: python classify.py --login
# GMAIL_CREDENTIALS=credentials.json
# GMAIL_TOKEN=token.json

# Optional Gmail label applied with --flag (stars the message either way)
# GMAIL_LABEL=Jev/Attention

# Optional. Helps Jev judge what *you* consider important.
# RECIPIENT_PRIORITIES=I care about work mail, friends/family, billing/security, and calendar. Ignore newsletters, promos, and most GitHub/social notifications unless I am @mentioned or something is broken.
